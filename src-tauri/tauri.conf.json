{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Margin Calendar",
  "version": "0.0.6",
  "identifier": "studio.margin.calendar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1360,
        "height": 900,
        "minWidth": 880,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 9,
          "y": 25
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "studio.margin.calendar"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "studio.margin.calendar"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "category": "Productivity",
    "shortDescription": "A calendar for Google Calendar",
    "longDescription": "A calendar where the grid owns the window and the day always fits without scrolling.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
